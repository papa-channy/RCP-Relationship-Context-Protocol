{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcp:schema:provider-capability:0.1",
  "title": "RCP ProviderCapability",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "rcp_version", "provider", "capability_version", "capabilities", "issued_at"],
  "properties": {
    "type": {"const": "rcp.provider_capability"},
    "rcp_version": {"const": "0.1"},
    "provider": {"type": "string", "minLength": 1},
    "capability_version": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "anyOf": [
          {
            "enum": [
              "identity",
              "interaction_metadata",
              "content",
              "provider_context",
              "external_processing",
              "secure_envelope",
              "revocation_events",
              "policy_events"
            ]
          },
          {"pattern": "^x-[A-Za-z0-9.-]+:[A-Za-z0-9_.-]+$"}
        ]
      },
      "additionalProperties": {"enum": ["allow", "deny", "limited"]}
    },
    "limitation_refs": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "processing_locations": {
      "type": "array",
      "items": {
        "anyOf": [
          {"enum": ["provider", "device", "consumer", "relay", "confidential_compute", "third_party"]},
          {"pattern": "^x-[A-Za-z0-9.-]+:[A-Za-z0-9_.-]+$"}
        ]
      },
      "uniqueItems": true
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
