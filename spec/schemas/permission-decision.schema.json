{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rcp.example/spec/schemas/permission-decision.schema.json",
  "title": "RCP PermissionDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "decision_id", "request_id", "decision", "evaluated_at"],
  "properties": {
    "type": {"const": "rcp.permission_decision"},
    "decision_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["allow", "deny", "conditional", "unknown"]},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "required_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "policy_versions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "evaluated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision": {"const": "conditional"}},
        "required": ["decision"]
      },
      "then": {"required": ["required_conditions", "expires_at"]}
    },
    {
      "if": {
        "properties": {"decision": {"enum": ["deny", "unknown"]}},
        "required": ["decision"]
      },
      "then": {"required": ["reason_codes"]}
    },
    {
      "if": {
        "properties": {"decision": {"const": "allow"}},
        "required": ["decision"]
      },
      "then": {"required": ["expires_at"]}
    }
  ]
}
