{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcp:schema:context-assertion:0.1",
  "title": "RCP ContextAssertion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "rcp_version",
    "assertion_id",
    "assertion_type",
    "epistemic_class",
    "statement",
    "provenance",
    "status",
    "created_at"
  ],
  "properties": {
    "type": {"const": "rcp.context_assertion"},
    "rcp_version": {"const": "0.1"},
    "assertion_id": {"type": "string", "minLength": 1},
    "assertion_type": {
      "anyOf": [
        {
          "enum": [
            "fact",
            "source_statement",
            "commitment",
            "decision",
            "preference",
            "interest",
            "goal",
            "status",
            "event",
            "open_loop",
            "followup",
            "constraint",
            "risk",
            "organization_context",
            "relationship_context",
            "strategy"
          ]
        },
        {"pattern": "^x-[A-Za-z0-9.-]+:[A-Za-z0-9_.-]+$"}
      ]
    },
    "epistemic_class": {
      "enum": [
        "source_statement",
        "verified_fact",
        "extracted_fact",
        "user_observation",
        "system_interpretation",
        "system_inference",
        "strategy",
        "unknown"
      ]
    },
    "statement": {"type": "string", "minLength": 1},
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "relationship": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_type", "visibility"],
      "properties": {
        "origin_type": {
          "enum": [
            "external_provider",
            "user_authored",
            "provider_generated",
            "system_generated",
            "imported",
            "derived",
            "unknown"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "visibility": {
          "enum": ["full", "redacted", "type_only", "internal_only", "hidden"]
        }
      }
    },
    "policy_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "status": {
      "enum": ["active", "superseded", "expired", "disputed", "invalidated", "revoked"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"}
  },
  "anyOf": [
    {"required": ["subjects"]},
    {"required": ["relationship"]}
  ]
}
