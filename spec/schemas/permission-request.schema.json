{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rcp.example/spec/schemas/permission-request.schema.json",
  "title": "RCP PermissionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "request_id", "requester", "executor", "action", "purpose", "requested_at"],
  "properties": {
    "type": {"const": "rcp.permission_request"},
    "request_id": {"type": "string", "minLength": 1},
    "requester": {"type": "string", "minLength": 1},
    "executor": {"type": "string", "minLength": 1},
    "action": {
      "enum": ["discover", "access", "delegate", "transfer", "process", "derive", "store", "disclose", "act", "train"]
    },
    "resource": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "destination": {"type": "string", "minLength": 1},
    "processing_location": {"type": "string", "minLength": 1},
    "requested_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "enum": ["access", "delegate", "transfer", "process", "derive", "store", "disclose", "act", "train"]
          }
        },
        "required": ["action"]
      },
      "then": {"required": ["resource"]}
    }
  ]
}
