{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcp:schema:secure-envelope:0.1",
  "title": "RCP SecureEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "rcp_version",
    "envelope_id",
    "sender",
    "recipient",
    "action",
    "resource_ref",
    "resource_class",
    "purpose",
    "destination",
    "processing_location",
    "permission_decision_ref",
    "issued_at",
    "expires_at",
    "payload",
    "signature"
  ],
  "properties": {
    "type": {"const": "rcp.secure_envelope"},
    "rcp_version": {"const": "0.1"},
    "envelope_id": {"type": "string", "minLength": 1},
    "sender": {"type": "string", "minLength": 1},
    "recipient": {"type": "string", "minLength": 1},
    "action": {
      "enum": ["discover", "access", "delegate", "transfer", "process", "derive", "store", "disclose", "act", "train"]
    },
    "resource_ref": {"type": "string", "minLength": 1},
    "resource_class": {"type": "string", "minLength": 1},
    "purpose": {
      "anyOf": [
        {
          "enum": [
            "relationship_memory",
            "meeting_preparation",
            "followup_assistance",
            "personal_search",
            "identity_resolution",
            "service_security",
            "service_operations",
            "evaluation",
            "model_training",
            "advertising",
            "employee_monitoring",
            "credit_scoring",
            "data_brokerage",
            "surveillance"
          ]
        },
        {"pattern": "^x-[A-Za-z0-9.-]+:[A-Za-z0-9_.-]+$"}
      ]
    },
    "destination": {"type": "string", "minLength": 1},
    "processing_location": {
      "anyOf": [
        {"enum": ["provider", "device", "consumer", "relay", "confidential_compute", "third_party"]},
        {"pattern": "^x-[A-Za-z0-9.-]+:[A-Za-z0-9_.-]+$"}
      ]
    },
    "permission_decision_ref": {"type": "string", "minLength": 1},
    "policy_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "alg", "kid", "ciphertext", "payload_hash"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "alg": {"type": "string", "minLength": 1},
        "kid": {"type": "string", "minLength": 1},
        "ciphertext": {"type": "string", "minLength": 1},
        "payload_hash": {"type": "string", "minLength": 1}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "alg", "kid", "value"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "alg": {"type": "string", "minLength": 1},
        "kid": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    }
  }
}
