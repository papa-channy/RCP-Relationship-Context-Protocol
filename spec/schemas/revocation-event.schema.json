{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rcp.example/spec/schemas/revocation-event.schema.json",
  "title": "RCP RevocationEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "event_id", "revocation_type", "scope", "effective_at"],
  "properties": {
    "type": {"const": "rcp.revocation_event"},
    "event_id": {"type": "string", "minLength": 1},
    "revocation_type": {
      "enum": ["user_grant", "provider", "organization_policy", "counterparty_restriction", "legal_invalidation", "security"]
    },
    "scope": {"type": "object"},
    "reason": {"type": "string"},
    "effective_at": {"type": "string", "format": "date-time"},
    "issuer": {"type": "string"}
  }
}
