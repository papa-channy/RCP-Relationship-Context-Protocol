{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcp:schema:revocation-event:0.1",
  "title": "RCP RevocationEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "rcp_version",
    "event_id",
    "revocation_type",
    "scope",
    "issuer",
    "issued_at",
    "effective_at"
  ],
  "properties": {
    "type": {"const": "rcp.revocation_event"},
    "rcp_version": {"const": "0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "revocation_type": {
      "enum": [
        "user_grant",
        "provider",
        "organization_policy",
        "counterparty_restriction",
        "legal_invalidation",
        "security"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_type", "scope_id"],
      "properties": {
        "scope_type": {
          "enum": [
            "grant",
            "provider",
            "account",
            "relationship",
            "resource",
            "object",
            "policy",
            "legal_basis",
            "security_context"
          ]
        },
        "scope_id": {"type": "string", "minLength": 1}
      }
    },
    "reason_code": {"type": "string", "minLength": 1},
    "reason": {"type": "string"},
    "issuer": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "effective_at": {"type": "string", "format": "date-time"}
  }
}
